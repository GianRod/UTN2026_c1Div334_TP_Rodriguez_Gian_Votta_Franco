<%- include('partials/header', { usuario }) %>

<section class="form-container">
  <h2>Crear usuario nuevo</h2>

  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <form action="/admin/usuario/alta" method="POST" class="producto-form">
    <label>Nombre
      <input type="text" name="nombre" required />
    </label>

    <label>Email
      <input type="email" name="email" required />
    </label>

    <label>Password
      <input type="password" name="password" minlength="6" required />
    </label>

    <label class="checkbox-label">
      <input type="checkbox" name="es_admin" />
      <span>Asignar permisos de administrador</span>
    </label>

    <p class="form-help">
      El ID, la fecha de creacion y la fecha de actualizacion se generan automaticamente.
    </p>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Crear usuario</button>
      <a href="/admin/dashboard" class="btn btn-secondary">Cancelar</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
